# Copie este arquivo para ".env" (NÃO renomeie: o .env.example deve continuar no repositório)
# e preencha os valores. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# --- EmailJS (formulário de contato) — emailjs.com ---
# Service ID: Email Services | Template ID: Email Templates ({{name}}, {{email}}, {{message}}) | Public Key: Account > General
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Supabase (curtidas do YouTube + contador de visitas) — supabase.com ---
# Project Settings > API: "Project URL" e a chave "publishable" (ou "anon public")
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Last.fm (widget "tocando agora") — last.fm/api/account/create ---
VITE_LASTFM_USER=
VITE_LASTFM_API_KEY=

# --- WakaTime (estatísticas de código) — wakatime.com/settings/api-key ---
# SEM o prefixo VITE_: esta chave é secreta e só é lida pela função serverless em api/wakatime.js
WAKATIME_API_KEY=
